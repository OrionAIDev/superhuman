# Force LF for files whose `run:` blocks execute on POSIX CI runners
.github/workflows/*.yml text eol=lf

# Force LF for files that must be executable on POSIX systems
hooks/session-start text eol=lf
scripts/cleanup-project.sh text eol=lf
scripts/release.sh text eol=lf
scripts/git-hooks/pre-commit text eol=lf
scripts/install-hooks.sh text eol=lf
examples/promote.sh.example text eol=lf
scripts/autonomous-precondition.sh text eol=lf
scripts/autonomous-rollback.sh text eol=lf
scripts/autonomous-summary.sh text eol=lf
scripts/autonomous-iter.sh text eol=lf

# NFR-3 fixtures whose entire point is a specific, non-native line-ending
# byte sequence (CRLF / lone CR). `-text` disables autocrlf conversion so
# the exact bytes survive commit/checkout on any platform.
tests/fixtures/gate_records/crlf_variant.md -text
tests/fixtures/gate_records/cr_variant.md -text
