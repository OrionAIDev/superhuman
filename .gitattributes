# Force LF for files whose `run:` blocks execute on POSIX CI runners
.github/workflows/*.yml text eol=lf

# Force LF for files that must be executable on POSIX systems
hooks/session-start text eol=lf
scripts/cleanup-project.sh text eol=lf
scripts/release.sh text eol=lf
scripts/git-hooks/pre-commit text eol=lf
scripts/install-hooks.sh text eol=lf
examples/promote.sh.example text eol=lf
scripts/autonomous-precondition.sh text eol=lf
scripts/autonomous-rollback.sh text eol=lf
scripts/autonomous-summary.sh text eol=lf
scripts/autonomous-iter.sh text eol=lf

# Hook TEMPLATES are copied by operators and run by POSIX shells. They are
# LF today only because every committer so far had core.autocrlf set; the
# declaration makes that independent of contributor config, as it already
# is for every other POSIX script above. CRLF would break these twice: a
# shebang ending in a carriage return names no valid interpreter, and a
# trailing backslash would escape that carriage return rather than
# continue the line.
templates/hooks/SessionStart text eol=lf
templates/hooks/PreToolUse text eol=lf

# Reference scripts the docs invoke directly (`./find-polluter.sh`,
# `./render-graphs.js`, `scripts/start-server.sh`). Same reasoning as above:
# LF today by contributor convention rather than by declaration.
references/brainstorming/scripts/start-server.sh text eol=lf
references/brainstorming/scripts/stop-server.sh text eol=lf
references/systematic-debugging/find-polluter.sh text eol=lf
references/writing-skills/render-graphs.js text eol=lf

# The last two shebang-bearing files. Materially weaker case than everything
# above, and deliberately deferred in #15 for that reason: CRLF does not break
# the Python interpreter, which reads source under universal newlines, so a
# carriage return survives `python scripts/<name>.py` harmlessly. Only the
# `scripts/superhuman_profile.py <cmd>` form README documents would break, and
# only on its shebang. Declared anyway so that every shebang in the repo is
# covered by rule rather than by contributor `core.autocrlf` config.
scripts/regen_core_manifest.py text eol=lf
scripts/superhuman_profile.py text eol=lf
