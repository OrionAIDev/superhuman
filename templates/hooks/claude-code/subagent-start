#!/usr/bin/env bash
# templates/hooks/claude-code/subagent-start — the deterministic
# SubagentStart hook for fleet dispatch observation (fleet-deterministic-
# seams Chunk 7). Supersedes templates/hooks/PreToolUse, which required
# hand-filled placeholder tokens and had no in-body Decision C granularity
# filter.
#
# Installed via `fleet hooks install` (Chunk 8) into a harness's
# SubagentStart hook config (e.g. Claude Code's `~/.claude/settings.json`,
# matcher `*`). Never installed automatically by this skill on its own —
# `templates/hooks/` ships templates, not live hooks.
#
# Purpose: give the spawned-dispatch registration a DETERMINISTIC ceiling on
# top of the portable prose floor (`roles/pm.md` / `phases/3-implementation.md`,
# "after each role dispatch, call `python -m scripts.fleet.cli observe
# dispatch`"). This wrapper calls the SAME entry point the prose floor calls
# -- `python -m scripts.fleet.cli observe dispatch` -- so the hook and the
# floor can never diverge (FR-15; D4's boundary rule: no parallel or
# divergent invocation may exist anywhere in this script).
#
# **FR-18 is the load-bearing requirement of this whole file: exit code 2 on
# SubagentStart BLOCKS THE SUBAGENT.** "Exit 0 under every fault" is
# therefore a correctness requirement, not a quality goal -- this script's
# own exit status is NEVER allowed to reach the harness as non-zero, under
# any injected fault (corrupted payload, missing interpreter, unreadable
# transcript, a deleted workspace, a hung subprocess, a simulated full disk
# -- see tests/fleet/test_hooks.py's fault-injection matrix, TC-42..TC-49).
# `observe dispatch` itself always exits 0 (fail-soft -- see
# scripts/fleet/observe.py's module docstring), and everything below
# additionally traps so an interpreter failure or a moved skill root can
# never propagate.
#
# stdout carries at most the one line `subagent_dispatch_filter.py` prints
# internally (never surfaced to the harness -- see below); nothing this
# script itself does writes to stdout. Only stderr is discarded throughout,
# matching session-start's stance.
trap 'exit 0' EXIT

# --- capture stdin ONCE ------------------------------------------------------
#
# The Decision C granularity filter (D5) and `observe dispatch` both need
# the SAME payload JSON, and a pipe can only be read once. Read it into a
# shell variable here rather than re-reading stdin twice.
payload="$(cat 2>/dev/null || true)"

# --- locate the superhuman skill checkout (no SLUG placeholder) -----------
#
# This script itself lives at templates/hooks/claude-code/subagent-start
# inside the skill checkout, so its own path is a reliable anchor for the
# skill root regardless of where the harness's config points at it from --
# unlike the workspace under observation, this path is fixed at install
# time. Overridable via $SUPERHUMAN_ROOT for a non-standard layout.
SUPERHUMAN_ROOT="${SUPERHUMAN_ROOT:-$(cd "$(dirname "$0")/../../.." && pwd)}"

# --- resolve a Python interpreter that actually RUNS (ARCHITECTURE.md §6.3) -
#
# Each candidate is EXECUTED, not merely tested for existence or the
# executable bit -- see templates/hooks/claude-code/session-start's
# identical comment for why (the Microsoft Store "app execution alias"
# stub). Mirrors scripts/autonomous-precondition.sh's identical guard.
PYTHON=""
for candidate in \
  "$(command -v python3 2>/dev/null || true)" \
  "$(command -v python 2>/dev/null || true)"
do
  [ -n "$candidate" ] || continue
  if "$candidate" -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
    PYTHON="$candidate"
    break
  fi
done
[ -z "$PYTHON" ] && exit 0

# --- CLAUDE_PROJECT_DIR: the preferred anchor, payload cwd is the fallback -
#
# Same rationale as templates/hooks/claude-code/session-start -- see that
# script's identical comment (ARCHITECTURE.md Addendum §A / CHUNK-1-
# FINDINGS.md finding 8). Passed through to `observe dispatch` generically
# as `--anchor`; `scripts/fleet/cli.py` names no harness (D4).
ANCHOR_ARGS=()
if [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
  ANCHOR_ARGS=(--anchor "$CLAUDE_PROJECT_DIR")
fi

# --- Decision C granularity filter (D5) -------------------------------------
#
# Harness-specific transcript parsing lives in subagent_dispatch_filter.py,
# beside this script (D4: no harness name enters scripts/fleet/); the
# portable predicate it applies lives in scripts/fleet/dispatch_predicate.py.
# A role dispatch registers; a research fan-out (or a payload/transcript
# this filter cannot make sense of) does not -- the filter's own broad catch
# degrades every failure to "skip", never a traceback, never non-zero.
decision="$(
  printf '%s' "$payload" | "$PYTHON" \
    "$SUPERHUMAN_ROOT/templates/hooks/claude-code/subagent_dispatch_filter.py" \
    --hook-payload - 2>/dev/null
)"

if [ "$decision" != "register" ]; then
  exit 0
fi

(
  cd "$SUPERHUMAN_ROOT" \
    && printf '%s' "$payload" | "$PYTHON" -m scripts.fleet.cli observe dispatch \
      --hook-payload - \
      --harness subagent \
      "${ANCHOR_ARGS[@]}"
) 2>/dev/null

exit 0
